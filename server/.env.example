PORT=5000
CLIENT_URL=http://localhost:5173
# Local MongoDB is the most reliable option for development.
MONGODB_URI=mongodb://127.0.0.1:27017/sidmegle
# For MongoDB Atlas, use your own credentials and keep this value only in server/.env:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority&appName=<app-name>
# Optional: use this if Node reports querySrv ECONNREFUSED while Windows DNS resolves Atlas.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
NODE_ENV=development
ADMIN_TOKEN=replace-with-a-long-random-value
JSON_LIMIT=50kb
REQUEST_TIMEOUT_MS=15000
MAX_SOCKET_PAYLOAD_BYTES=100000
MAX_SOCKETS_PER_IP=10
MAX_CONN_PER_IP_PER_MIN=30
TRUST_CLOUDFLARE_HEADERS=false
# For production WebRTC (TURN), e.g.:
# Keep TURN credentials server-issued where possible; never put backend secrets in VITE_*.
